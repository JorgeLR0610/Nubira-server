NUBIRA_PUBLIC_URL=http://localhost:3000
NUBIRA_MAIL_MODE=file
NUBIRA_MAIL_DIR=./workspace/mail
NUBIRA_DB_PATH=./workspace/nubira.sqlite3
NUBIRA_ALERT_THRESHOLD_PP=10
# Autocompletado de direcciones (opcional). Configura la clave solo en la API.
# NUBIRA_GEOAPIFY_API_KEY=
# Búsqueda manual opcional, solo al pulsar Buscar; no se usa para sugerir direcciones.
# NUBIRA_GEOCODER_CONTACT=ops@ejemplo.com
# NUBIRA_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# En producción usa HTTPS y configura SMTP.
# NUBIRA_MAIL_MODE=smtp
# NUBIRA_MAIL_FROM=notificaciones@ejemplo.com
# NUBIRA_SMTP_HOST=smtp.ejemplo.com
# NUBIRA_SMTP_PORT=587
# NUBIRA_SMTP_USER=
# NUBIRA_SMTP_PASSWORD=
# NUBIRA_SMTP_IMPLICIT_TLS=0
