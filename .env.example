# Local por defecto. La imagen de Lightsail exige PostgreSQL; aquí no se guardan credenciales.
DATABASE_URL=
# Producción (pegar la URL completa de Neon, conservando sus parámetros TLS):
# DATABASE_URL=postgresql://USUARIO:CLAVE@HOST_NEON/BASE?sslmode=require
# NUBIRA_REQUIRE_POSTGRES=1
# NUBIRA_DB_PATH=./workspace/nubira.sqlite3

PORT=8000
# NUBIRA_BIND_HOST=127.0.0.1
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Producción: usa el origen público real de Vercel o del dominio personalizado.
# FRONTEND_URL=https://nubira-weather.vercel.app
# CORS_ORIGINS=https://nubira-weather.vercel.app

# file: bandeja de pruebas, solo local; console: simula sin imprimir enlaces ni enviar.
MAIL_PROVIDER=file
NUBIRA_MAIL_DIR=./workspace/mail
# Producción:
# MAIL_PROVIDER=smtp
# SMTP_HOST=email-smtp.us-east-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=notificaciones@example.com

# 0 desactiva el monitor integrado; 900 es el valor por defecto en la imagen.
# NUBIRA_MONITOR_INTERVAL=900
NUBIRA_ALERT_THRESHOLD_PP=10
# NUBIRA_INFERENCE_CONCURRENCY=1

# Opcionales. La API conserva el mapa y las coordenadas sin un proveedor.
# NUBIRA_GEOAPIFY_API_KEY=
# NUBIRA_GEOCODER_CONTACT=ops@example.com
# NUBIRA_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# NUBIRA_MODEL_PATH=./artifacts/best_weather_risk_model.pt
# NUBIRA_CLIMATE_CONTEXT_PATH=./artifacts/climate_context.npz
